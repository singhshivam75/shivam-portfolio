# Public URL of the deployed site (used for canonical URLs, sitemap and Open Graph).
NEXT_PUBLIC_SITE_URL=https://your-domain.com

# SMTP settings for the contact form (server-side only, never exposed to the browser).
# Gmail: enable 2-Step Verification, then create an App Password at
# https://myaccount.google.com/apppasswords and use it as SMTP_PASS.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=singh8375shivam@gmail.com
SMTP_PASS=your-app-password

# Optional overrides. Defaults: TO = email in src/content/portfolio.ts, FROM = SMTP_USER.
CONTACT_TO_EMAIL=
CONTACT_FROM_EMAIL=
